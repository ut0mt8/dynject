<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dynject.dynjectd</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/dynject/bin/dynject_loader</string>
        <string>-d</string>
        <string>/opt/dynject/bin/dynjectd</string>
        <string>-c</string>
        <string>/opt/dynject/etc/dynjectd.conf</string>
        <string>-l</string>
        <string>/opt/dynject/log/dynjectd.log</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>UserName</key>
    <string>root</string>
    <key>StandardOutPath</key>
    <string>/opt/dynject/log/dynjectd.log</string>
    <key>StandardErrorPath</key>
    <string>/opt/dynject/log/dynjectd.error.log</string>
</dict>
</plist>
